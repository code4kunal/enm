# Flutter / Dart
app/build/
app/.dart_tool/
app/.flutter-plugins-dependencies
app/.packages

# Python
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/.pytest_cache/
backend/.ruff_cache/
backend/media/
backend/secrets/*
!backend/secrets/.gitkeep

# Env and secrets — never commit these
.env
.env.dev
.env.prod
backend/.env
backend/.env.dev
backend/.env.prod
# Keep templates tracked:
#   .env.example, .env.dev.example, .env.prod.example
*.pem
*.key

# Editors and OS
.DS_Store
.idea/
*.iml
.vscode/

# MBMT's own operational records — bus numbers, defects, staff names. Kept on
# disk because the importers and their tests read them, never in the history:
# this repository is not where a customer's data belongs.
/data/

# Local git worktrees (SDD implementation workspaces)
.worktrees/
