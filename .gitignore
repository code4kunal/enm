# Flutter / Dart
app/build/
app/.dart_tool/
app/.flutter-plugins-dependencies
app/.packages

# Python
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/.pytest_cache/
backend/.ruff_cache/
backend/media/
