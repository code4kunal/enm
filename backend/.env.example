# --- app ---
ENVIRONMENT=development
DEBUG=false
# Host port the API container is published on (compose default is 8000).
API_PORT=8123
# Local docker compose maps API to 8123 when 8000 is taken (see README).
PUBLIC_BASE_URL=http://localhost:8123
# Comma-separated browser origins allowed to call the API.
# Must be explicit — "*" with credentials is rejected by browsers.
# Include every host:port that serves the Flutter web UI (compose WEB_PORT,
# reverse-proxy hostname, LAN IP). Server example:
# CORS_ORIGINS=http://localhost:8080,http://YOUR_SERVER:8080,https://dev-enm.transvolt.org
CORS_ORIGINS=http://localhost:8080,http://localhost:8089,http://127.0.0.1:8080,http://127.0.0.1:8089

# --- docker compose ports ---
# Host port for PostgreSQL (compose default 5433)
DB_PORT=5433
# Host port for the Flutter web frontend (compose default 8080)
WEB_PORT=8080
# Full browser-reachable API URL baked into the Flutter web build at image build
# time (must include /api/v1). NOT the internal docker hostname (http://api:8000).
# Rebuild the web service after changing: docker compose build web
API_PUBLIC_URL=http://localhost:8123/api/v1
# Optional alias for API_PUBLIC_URL (WEB_API_BASE_URL takes precedence in compose)
# WEB_API_BASE_URL=http://localhost:8123/api/v1

# --- SiteOps platform (backend login fallback; Flutter uses --dart-define) ---
SITEOPS_BASE_URL=https://dev-siteops-platform.transvolt.org/api/v1

# --- database ---
DATABASE_URL=postgresql+asyncpg://enm:enm@localhost:5433/enm

# --- auth ---
# openssl rand -hex 32
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_TTL_SECONDS=86400
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- Microsoft Entra ID SSO (blank disables /auth/sso) ---
MS_TENANT_ID=
MS_CLIENT_ID=

# --- notifications / FCM ---
NOTIFICATIONS_ENABLED=true
FCM_CREDENTIALS_FILE=
FCM_PROJECT_ID=
BREAKDOWN_SLA_ENABLED=true
BREAKDOWN_SLA_HOURS=4
BREAKDOWN_SLA_SCAN_MINUTES=30

# --- seed ---
SEED_ON_START=true
BOOTSTRAP_USER_ID=TV4021
BOOTSTRAP_PASSWORD=Transvolt@123

# --- Microsoft Entra ID sign-in (optional) ---
# Leave both blank and the app serves the User ID form only — the sign-in card
# hides the Microsoft button rather than offering one that fails.
# The app registration needs the app's own origin listed as a
# *single-page application* redirect URI, and the openid scope granted.
MS_TENANT_ID=
MS_CLIENT_ID=
