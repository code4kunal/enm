# --- app ---
ENVIRONMENT=development
DEBUG=false
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=*

# --- database ---
DATABASE_URL=postgresql+asyncpg://enm:enm@localhost:5433/enm

# --- auth ---
# openssl rand -hex 32
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_TTL_SECONDS=86400
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- Microsoft Entra ID SSO (blank disables /auth/sso) ---
MS_TENANT_ID=
MS_CLIENT_ID=

# --- notifications / FCM ---
NOTIFICATIONS_ENABLED=true
FCM_CREDENTIALS_FILE=
FCM_PROJECT_ID=
BREAKDOWN_SLA_ENABLED=true
BREAKDOWN_SLA_HOURS=4
BREAKDOWN_SLA_SCAN_MINUTES=30

# --- seed ---
SEED_ON_START=true
