# Local development template — copy then use:
#   cp .env.dev.example .env.dev
#   docker compose --env-file .env.dev up -d --build
# Or:  cp .env.dev.example .env
#
# Safe defaults only. Do not put real production secrets here.
# See also .env.example for the general documented template (incl. public-host notes).

# --- app ---
ENVIRONMENT=development
DEBUG=false
# Host port the API container is published on
API_PORT=8123
PUBLIC_BASE_URL=http://localhost:8123
# Browser origins that serve the Flutter web UI (compose WEB_PORT + common local ports)
CORS_ORIGINS=http://localhost:8080,http://localhost:8089,http://127.0.0.1:8080,http://127.0.0.1:8089

# --- docker compose ports ---
# Host port for PostgreSQL
DB_PORT=5433
# Host port for the Flutter web frontend (matches current local setup)
WEB_PORT=8089
# Full browser-reachable API URL baked into the Flutter web image at build time
# (must include /api/v1). Rebuild web after changing:
#   docker compose --env-file .env.dev build --no-cache web
API_PUBLIC_URL=http://localhost:8123/api/v1

# --- SiteOps platform (backend login fallback; Flutter uses --dart-define) ---
SITEOPS_BASE_URL=https://dev-siteops-platform.transvolt.org/api/v1
# Server-to-server key for Vehicle Master / Sync fleet (X-Service-Key).
# Copy the value from your local `.env` or ask SiteOps — never commit the real one.
SITEOPS_SERVICE_KEY=
# The platform's own token-signing secret (JWT_SECRET_KEY in its .env).
# siteops-platform is the estate's only token issuer: E&M verifies its HS256
# signature with this and reads roles, permissions and site_ids from the
# claims. It must NOT equal JWT_SECRET above — the app refuses to start in
# production if the two issuers are indistinguishable. Empty turns platform
# sign-in off and leaves only E&M-local accounts.
SITEOPS_JWT_SECRET=
# Register E&M's em_* permissions with the platform's catalogue at startup,
# so an administrator can attach them to roles. Idempotent.
PERMISSION_SYNC_ENABLED=true
# Check passwords against the platform at /auth/login.
PLATFORM_LOGIN_ENABLED=true

# --- database ---
# For tools on the host (psql, make test). Inside compose, the API uses db:5432.
DATABASE_URL=postgresql+asyncpg://enm:enm@localhost:5433/enm

# --- auth ---
# Placeholder only — replace before any shared or production-like deploy
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=86400
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- Microsoft Entra ID SSO (blank disables /auth/sso) ---
MS_TENANT_ID=
MS_CLIENT_ID=

# --- notifications / FCM ---
NOTIFICATIONS_ENABLED=true
FCM_CREDENTIALS_FILE=
FCM_PROJECT_ID=
BREAKDOWN_SLA_ENABLED=true
BREAKDOWN_SLA_HOURS=4
BREAKDOWN_SLA_SCAN_MINUTES=30

# --- seed ---
# Prefer false when reusing an existing local DB volume; set true for a fresh wipe+seed
SEED_ON_START=false
BOOTSTRAP_USER_ID=TV4021
BOOTSTRAP_PASSWORD=Transvolt@123
